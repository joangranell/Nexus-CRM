# ==========================================
# Nexus CRM - Variables de Entorno
# ==========================================

# Configuración General del Servidor
PROJECT_NAME="Nexus CRM"
API_V1_PREFIX="/api"
SECRET_KEY="nexus_crm_super_secret_jwt_key_2026_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de Datos (SQLite local por defecto; compatible con PostgreSQL)
DATABASE_URL="sqlite:///./nexus_crm.db"

# Webhooks
WEBHOOK_API_KEY="nexus_webhook_secret_key_2026"

# Inteligencia Artificial (Google Gemini) - Fase 4
# Si se deja vacío, el sistema opera en modo Fallback Inteligente / Mock
GEMINI_API_KEY=""

# Mailing Multi-Proveedor - Fase 3 (sandbox | mailchimp | brevo | resend)
MAILING_PROVIDER="sandbox"
MAILCHIMP_API_KEY=""
MAILCHIMP_SERVER_PREFIX="us1"
MAILCHIMP_LIST_ID=""
BREVO_API_KEY=""
RESEND_API_KEY=""
